# Copie para .env.staging na VM, substitua todos os placeholders e aplique chmod 600.
NODE_ENV=production
APP_ENV=staging
APP_PORT=3000
APP_DOMAIN=staging.example.org
APP_BASE_URL=https://staging.example.org
APP_NAME=Plataforma de Cursos — Demonstração

DB_HOST=db
DB_PORT=3306
DB_NAME=plataforma_cursos_staging
DB_ENVIRONMENT_IDENTITY=plataforma_cursos_staging
DB_USER=plataforma_staging
DB_PASSWORD=<gere_com_openssl_rand_base64_36>
DB_POOL_MAX=10
DB_POOL_QUEUE_LIMIT=50
DB_POOL_WAIT_FOR_CONNECTIONS=true
DB_CONNECT_TIMEOUT_MS=10000
MYSQL_ROOT_PASSWORD=<gere_outro_segredo_com_openssl_rand_base64_36>
JWT_SECRET=<gere_com_openssl_rand_base64_48>

SESSION_TTL_SECONDS=28800
AUTH_RATE_LIMIT_MAX=20
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_PROVIDER_TIMEOUT_MS=10000
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
EMAIL_CODE_SEND_IP_RATE_LIMIT_MAX=20
EMAIL_CODE_SEND_IDENTITY_RATE_LIMIT_MAX=5
EMAIL_CODE_VERIFY_IP_RATE_LIMIT_MAX=60
EMAIL_CODE_VERIFY_IDENTITY_RATE_LIMIT_MAX=10
PASSWORD_RESET_TTL_MINUTES=20
PASSWORD_RECOVERY_RATE_LIMIT=5
PASSWORD_RESET_RATE_LIMIT=10
CORS_ORIGIN=https://staging.example.org
CSP_REPORT_ONLY=false
SLOW_REQUEST_MS=2000
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
DISK_WARNING_PERCENT=15
DISK_CRITICAL_PERCENT=5

# Deixe desabilitado até haver chave e remetente de staging reais.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=

DETECTOR_ENABLED=false
IA_ANALISE_URL=http://motor-ia:8000/api/analisar
IA_ANALISE_TIMEOUT_MS=10000
DETECTOR_API_URL=http://motor-ia:8000
DETECTOR_API_TIMEOUT_MS=15000
DETECTOR_API_TIMEOUT_INCREMENTAL_MS=8000
DETECTOR_API_TIMEOUT_COMPLETE_MS=20000
DETECTOR_RATE_LIMIT_MAX=60
DETECTOR_RATE_LIMIT_WINDOW_MS=60000
MOTOR_IA_API_URL=http://motor-ia:8000
MOTOR_IA_INTERNAL_API_TOKEN=

# Proteção adicional temporária aplicada pelo Caddy. Gere o hash na VM:
# docker run --rm caddy:2.8-alpine caddy hash-password --plaintext '<senha-forte>'
# Duplique cada $ do hash como $$ para o Docker Compose não interpolá-lo.
STAGING_BASIC_AUTH_USER=demo
STAGING_BASIC_AUTH_HASH=<hash_bcrypt_com_dolares_duplicados>
ACME_EMAIL=<email_operacional_para_avisos_do_certificado>

# Bootstrap explícito do primeiro ADMIN. Remova a senha após a primeira execução.
INITIAL_ADMIN_NOME=Administrador de Demonstração
INITIAL_ADMIN_CPF=91000000100
INITIAL_ADMIN_EMAIL=admin.demo@example.test
INITIAL_ADMIN_TELEFONE=41910000100
INITIAL_ADMIN_PASSWORD=<senha_forte_exclusiva_do_admin>
INITIAL_ADMIN_ALLOW_ADDITIONAL=

# PROFESSOR e ALUNO fictícios recebem esta senha. Não reutilize em outro ambiente.
STAGING_DEMO_PASSWORD=<senha_forte_compartilhada_apenas_na_demo>

# Confirmações destravadas apenas pelo script operacional, não persistidas aqui.
ALLOW_PRODUCTION_ADMIN_BOOTSTRAP=
ALLOW_PRODUCTION_MIGRATIONS=
ALLOW_STAGING_DEMO_SEED=
PDF_MAX_SIZE_MB=20
CERTIFICATE_UPLOAD_MAX_SIZE_MB=10
CERTIFICATE_PUBLIC_RATE_LIMIT_MAX=60
CERTIFICATE_UPLOAD_RATE_LIMIT_MAX=20
CERTIFICATE_RATE_LIMIT_WINDOW_MS=60000
CERTIFICATE_INSTITUTION_NAME=Universidade Tecnológica Federal do Paraná
CERTIFICATE_CAMPUS=Campus Ponta Grossa
CERTIFICATE_RESPONSIBLE_ROLE=Responsável acadêmico

# Reconciliação manual; nunca aplicada automaticamente no startup.
MATERIAL_RETENTION_DAYS=90
STORAGE_GRACE_HOURS=48

# Backup local + Azure Blob privado. Secrets de recuperação permanecem separados.
BACKUP_DIR=/var/backups/plataforma-cursos
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_SCHEDULE='*-*-* 03:15:00 America/Sao_Paulo'
BACKUP_OFFSITE_ENABLED=true
BACKUP_REMOTE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT=<storage_account_privado>
AZURE_STORAGE_CONTAINER=plataforma-backups
BACKUP_REMOTE_PREFIX=plataforma-cursos/backups
BACKUP_OFFSITE_RETENTION_DAYS=30
BACKUP_DRILL_DIR=/var/backups/plataforma-cursos-drills
RPO_HOURS=24
RTO_HOURS=4
