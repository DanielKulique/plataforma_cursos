NODE_ENV=development
APP_ENV=development
APP_PORT=3000
DB_HOST=127.0.0.1
DB_PORT=33307
DB_USER=<usuario_mysql>
DB_PASSWORD=<senha_mysql>
DB_NAME=plataforma_cursos_dev
DB_ENVIRONMENT_IDENTITY=plataforma_cursos_dev
DB_POOL_MAX=10
DB_POOL_QUEUE_LIMIT=50
DB_POOL_WAIT_FOR_CONNECTIONS=true
DB_CONNECT_TIMEOUT_MS=10000
MYSQL_ROOT_PASSWORD=<senha_root_exclusiva_do_container_local>
JWT_SECRET=<segredo_jwt_longo_e_aleatorio>
CANONICAL_SEED_PASSWORD=<senha_local_para_os_usuarios_do_seed>
RESEND_API_KEY=<chave_resend_ou_deixe_vazio_em_desenvolvimento>
MAIL_FROM=<remetente_verificado>
EMAIL_DELIVERY_ENABLED=true
APP_NAME=<nome_da_aplicacao>
APP_BASE_URL=http://localhost:3000
SESSION_TTL_SECONDS=28800
AUTH_RATE_LIMIT_MAX=20
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_PROVIDER_TIMEOUT_MS=10000
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
EMAIL_CODE_SEND_IP_RATE_LIMIT_MAX=20
EMAIL_CODE_SEND_IDENTITY_RATE_LIMIT_MAX=5
EMAIL_CODE_VERIFY_IP_RATE_LIMIT_MAX=60
EMAIL_CODE_VERIFY_IDENTITY_RATE_LIMIT_MAX=10
PASSWORD_RESET_TTL_MINUTES=20
PASSWORD_RECOVERY_RATE_LIMIT=5
PASSWORD_RESET_RATE_LIMIT=10
DETECTOR_ENABLED=false
IA_ANALISE_URL=http://127.0.0.1:8000/api/analisar
DETECTOR_API_URL=http://127.0.0.1:8000
DETECTOR_API_TIMEOUT_MS=15000
DETECTOR_API_TIMEOUT_INCREMENTAL_MS=8000
DETECTOR_API_TIMEOUT_COMPLETE_MS=20000
DETECTOR_RATE_LIMIT_MAX=60
DETECTOR_RATE_LIMIT_WINDOW_MS=60000
MOTOR_IA_API_URL=http://127.0.0.1:8000
MOTOR_IA_INTERNAL_API_TOKEN=<segredo_exclusivo_entre_node_e_python>
RETRIEVAL_API_TIMEOUT_MS=20000
RETRIEVAL_MAX_RESPONSE_BYTES=1048576
RETRIEVAL_MAX_QUERY_CHARACTERS=50000
RETRIEVAL_TOP_K_MAX=50
RETRIEVAL_ANALYSIS_RATE_LIMIT_MAX=10
RETRIEVAL_STATUS_RATE_LIMIT_MAX=30
RETRIEVAL_RELOAD_RATE_LIMIT_MAX=2
RETRIEVAL_RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=<origens_separadas_por_virgula>
CSP_REPORT_ONLY=false
SLOW_REQUEST_MS=2000
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
DISK_WARNING_PERCENT=15
DISK_CRITICAL_PERCENT=5
BACKUP_STATUS_DIR=./backups
RPO_HOURS=24
MATERIAL_STORAGE_DIR=./storage/materials
PDF_MAX_SIZE_MB=20
CERTIFICATE_STORAGE_DIR=./storage/certificates
CERTIFICATE_UPLOAD_MAX_SIZE_MB=10
CERTIFICATE_PUBLIC_RATE_LIMIT_MAX=30
CERTIFICATE_UPLOAD_RATE_LIMIT_MAX=10
CERTIFICATE_RATE_LIMIT_WINDOW_MS=60000
CERTIFICATE_INSTITUTION_NAME=Universidade Tecnológica Federal do Paraná
CERTIFICATE_CAMPUS=
CERTIFICATE_RESPONSIBLE_ROLE=Responsável acadêmico
ALLOW_PRODUCTION_MIGRATIONS=

# Bootstrap explícito do primeiro administrador (npm run admin:bootstrap)
INITIAL_ADMIN_NOME=<nome_completo>
INITIAL_ADMIN_CPF=<cpf_com_11_digitos>
INITIAL_ADMIN_EMAIL=<email_do_administrador>
INITIAL_ADMIN_TELEFONE=<telefone_com_10_a_15_digitos>
INITIAL_ADMIN_PASSWORD=<senha_forte_sem_valor_padrao>
# Para um administrador adicional, use somente após revisão operacional.
INITIAL_ADMIN_ALLOW_ADDITIONAL=<I_UNDERSTAND_CREATE_ANOTHER_ADMIN_quando_aprovado>
ALLOW_PRODUCTION_ADMIN_BOOTSTRAP=

# Reconciliação manual; nunca aplicada automaticamente no startup.
MATERIAL_RETENTION_DAYS=90
STORAGE_GRACE_HOURS=48
