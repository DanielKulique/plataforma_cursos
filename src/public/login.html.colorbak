<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — Plágio</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    :root {
      --bg: #080c12;
      --yellow: #f5c518;
      --blue: #2563eb;
      --silver: #94a3b8;
      --status-ok: #22c55e;
      --ease: .18s cubic-bezier(.4,0,.2,1);
    }

    .light-mode {
      --bg: #f8fafc;
      --yellow: #d97706;
      --blue: #1d4ed8;
      --silver: #64748b;
      --border: rgba(0,0,0,.07);
      --border-2: rgba(0,0,0,.11);
    }

    :focus-visible {
      outline: 2px solid var(--yellow);
      outline-offset: 3px;
      border-radius: 4px;
    }

    .skip-link {
      position: absolute;
      top: -100px;
      left: 16px;
      z-index: 99999;
      padding: 8px 16px;
      border-radius: 6px;
      background: var(--yellow, #f5c518);
      color: #000;
      font-weight: 700;
      font-size: 13px;
      transition: top .2s;
    }

    .skip-link:focus-visible {
      top: 16px;
    }

    #toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 9999;
      display: flex;
      flex-direction: column-reverse;
      gap: 10px;
      pointer-events: none;
    }
  </style>
</head>
<body class="auth-page">
<a href="#main-content" class="skip-link">Pular para o conteúdo</a>

<main id="main-content" role="main">
<section class="auth-card" aria-labelledby="titulo-login">
  <div class="auth-card-head" style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px;">
    <div class="auth-brand">
      <div class="brand-mark">🧠</div>
      <div>
        <div class="auth-brand-text">Plágio</div>
        <div class="auth-brand-sub">Nao Copie Essa Ideia</div>
      </div>
    </div>
    <button class="theme-toggle" id="theme-toggle" title="Alternar tema" aria-label="Alternar tema">
      <span class="icon-moon">🌙</span>
      <span class="icon-sun">☀️</span>
    </button>
  </div>

  <p class="auth-kicker">Acesso a area do aluno</p>
  <h1 class="auth-title" id="titulo-login">Bem-vindo de volta</h1>
  <p class="auth-subtitle">Faca login para acessar seu painel e continuar sua jornada.</p>

  <form id="form-login" class="auth-form">
    <div class="form-group">
      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" placeholder="voce@email.com" autocomplete="email" required>
    </div>

    <div class="form-group">
      <label for="senha">Senha</label>
      <input type="password" id="senha" name="senha" minlength="8" placeholder="Sua senha" autocomplete="current-password" required>
    </div>

    <button type="submit" class="btn-submit">Entrar</button>
  </form>

  <p id="mensagem-login" class="auth-message" role="status" aria-live="polite"></p>

  <div class="auth-links">
    <p>Nao tem conta? <a href="/cadastro.html">Criar conta</a></p>
    <p><a href="/index.html">← Voltar para o catalogo</a></p>
  </div>
</section>
</main>

<script type="module" src="/js/theme.js"></script>
<script type="module" src="/js/login.js"></script>
<script>
  window.__loadingHint = 'loading';
  document.addEventListener('keydown', (e) => {
    if (['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName)) return;
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      const form = document.getElementById('form-login');
      if (form) form.requestSubmit();
    }
  });
</script>
<div id="toast-container" role="status" aria-live="polite"></div>
</body>
</html>
