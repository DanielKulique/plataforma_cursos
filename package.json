{
  "name": "site-curso",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "lint": "eslint .",
    "build": "node scripts/validate_database_isolation.js && node scripts/validate_production_assets.js",
    "test": "jest --coverage --detectOpenHandles --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --detectOpenHandles",
    "test:security": "jest --runInBand --runTestsByPath src/__tests__/frontend.security.test.js src/__tests__/admin.routes.security.test.js src/__tests__/conteudos.routes.security.test.js src/__tests__/logger.test.js src/__tests__/session.frontend.test.js src/__tests__/test_database_safety.test.js src/__tests__/detector-contextual.service.test.js src/__tests__/detector-contextual.validation.test.js",
    "test:integration": "jest --config=jest.integration.config.js --runInBand --detectOpenHandles",
    "test:migrations:unit": "jest --runInBand --runTestsByPath src/__tests__/migration-runner.test.js src/__tests__/schema_contract.test.js",
    "test:migrations:integration": "jest --config=jest.integration.config.js --runInBand --runTestsByPath src/__tests__/integration/migration-contract.integration.test.js",
    "test:migrations": "npm run test:migrations:unit && npm run test:migrations:integration",
    "test:integration:watch": "jest --config=jest.integration.config.js --watch",
    "db:dev:setup": "node scripts/setup_database.js dev",
    "db:dev:seed": "node scripts/seed_database.js dev",
    "db:dev:migrate:detector": "node scripts/migrate_detector_contextual_dev.js",
    "db:migrate": "node scripts/migrate_database.js",
    "db:migrate:status": "node scripts/migrate_database.js --status",
    "db:schema:validate": "node scripts/verify_schema.js",
    "db:schema:verify": "npm run db:schema:validate",
    "db:identity:verify": "node scripts/verify_database_identity.js",
    "db:identity:register": "node scripts/register_database_identity.js",
    "db:isolation:verify": "node scripts/validate_database_isolation.js",
    "db:test:setup": "node scripts/setup_database.js test",
    "db:test:seed": "node scripts/seed_database.js test",
    "admin:bootstrap": "node scripts/seed_admin_inicial.js",
    "production:bootstrap": "node scripts/production_bootstrap.js",
    "staging:seed": "node scripts/seed_staging_demo.js",
    "staging:smoke:identity": "node scripts/smoke_identity_email_staging.js",
    "staging:smoke:information-architecture": "node scripts/smoke_information_architecture_staging.js",
    "test:all": "npm run lint && npm test && npm run test:integration && npm run build",
    "test:stability": "npm run test:all && npm run test:all",
    "quality": "npm run test:all",
    "storage:reconcile": "node scripts/reconcile_storage.js",
    "backup:verify": "node scripts/backup_manifest.js verify",
    "backup:status": "scripts/backup_status.sh",
    "ops:check": "node scripts/operational_check.js",
    "restore:drill": "scripts/restore_drill.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "mysql2": "^3.14.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "resend": "^6.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.2.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/public/**/*.js",
      "!src/__tests__/integration/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    },
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "!**/__tests__/integration/**/*.test.js"
    ],
    "verbose": true,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
