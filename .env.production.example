NODE_ENV=production
APP_ENV=production
APP_RELEASE_SHA=<sha_completo_confirmado_no_github>
APP_PORT=3000
APP_DOMAIN=cursos.example.org
APP_BASE_URL=https://cursos.example.org
APP_NAME=Plataforma de Cursos

DB_HOST=db
DB_PORT=3306
DB_NAME=plataforma_cursos
DB_ENVIRONMENT_IDENTITY=plataforma_cursos_prod
DB_USER=plataforma_app
DB_PASSWORD=<senha_mysql_forte>
DB_POOL_MAX=10
DB_POOL_QUEUE_LIMIT=50
DB_POOL_WAIT_FOR_CONNECTIONS=true
DB_CONNECT_TIMEOUT_MS=10000
MYSQL_ROOT_PASSWORD=<senha_root_mysql_forte>

JWT_SECRET=<segredo_aleatorio_com_ao_menos_32_caracteres>
SESSION_TTL_SECONDS=28800
AUTH_RATE_LIMIT_MAX=20
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_PROVIDER_TIMEOUT_MS=10000
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
EMAIL_CODE_SEND_IP_RATE_LIMIT_MAX=20
EMAIL_CODE_SEND_IDENTITY_RATE_LIMIT_MAX=5
EMAIL_CODE_VERIFY_IP_RATE_LIMIT_MAX=60
EMAIL_CODE_VERIFY_IDENTITY_RATE_LIMIT_MAX=10
PASSWORD_RESET_TTL_MINUTES=20
PASSWORD_RECOVERY_RATE_LIMIT=5
PASSWORD_RESET_RATE_LIMIT=10

RESEND_API_KEY=<chave_resend>
MAIL_FROM=Plataforma de Cursos <nao-responda@example.org>
EMAIL_DELIVERY_ENABLED=false
PUBLIC_REGISTRATION_EMAIL_VERIFICATION_REQUIRED=false
CORS_ORIGIN=https://cursos.example.org
CSP_REPORT_ONLY=false
SLOW_REQUEST_MS=2000
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
DISK_WARNING_PERCENT=15
DISK_CRITICAL_PERCENT=5
PDF_MAX_SIZE_MB=20
CERTIFICATE_UPLOAD_MAX_SIZE_MB=10
CERTIFICATE_PUBLIC_RATE_LIMIT_MAX=30
CERTIFICATE_UPLOAD_RATE_LIMIT_MAX=10
CERTIFICATE_RATE_LIMIT_WINDOW_MS=60000
CERTIFICATE_INSTITUTION_NAME=Universidade Tecnológica Federal do Paraná
CERTIFICATE_CAMPUS=<campus_responsavel>
CERTIFICATE_RESPONSIBLE_ROLE=Responsável acadêmico

DETECTOR_ENABLED=false
IA_ANALISE_URL=http://motor-ia:8000/api/analisar
IA_ANALISE_TIMEOUT_MS=10000
DETECTOR_API_URL=http://motor-ia:8000
DETECTOR_API_TIMEOUT_MS=15000
DETECTOR_API_TIMEOUT_INCREMENTAL_MS=8000
DETECTOR_API_TIMEOUT_COMPLETE_MS=20000
DETECTOR_RATE_LIMIT_MAX=60
DETECTOR_RATE_LIMIT_WINDOW_MS=60000
MOTOR_IA_API_URL=http://motor-ia:8000
MOTOR_IA_INTERNAL_API_TOKEN=<configure_somente_quando_detector_habilitado>

# Dados não secretos para `npm run user:bootstrap`; senha somente no prompt oculto.
BOOTSTRAP_USER_NAME=
BOOTSTRAP_USER_CPF=
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PHONE=
BOOTSTRAP_USER_ROLE=
ALLOW_PRODUCTION_USER_BOOTSTRAP=
ALLOW_PRODUCTION_USER_VERIFY=
ALLOW_PRODUCTION_MIGRATIONS=
ALLOW_PRODUCTION_CONTENT_BOOTSTRAP=
BOOTSTRAP_COURSE_HOURS=
BOOTSTRAP_TEACHER_EMAIL=
BOOTSTRAP_START_DATE=
BOOTSTRAP_END_DATE=

# Reconciliação manual; nunca aplicada automaticamente no startup.
MATERIAL_RETENTION_DAYS=90
STORAGE_GRACE_HOURS=48

# Backup (offsite é obrigatório no service systemd de produção).
BACKUP_DIR=/var/backups/plataforma-cursos
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_SCHEDULE='*-*-* 03:15:00 America/Sao_Paulo'
BACKUP_OFFSITE_ENABLED=true
BACKUP_REMOTE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT=<storage_account_privado>
AZURE_STORAGE_CONTAINER=plataforma-backups
BACKUP_REMOTE_PREFIX=plataforma-cursos/backups
BACKUP_OFFSITE_RETENTION_DAYS=30
BACKUP_DRILL_DIR=/var/backups/plataforma-cursos-drills
RPO_HOURS=24
RTO_HOURS=4
